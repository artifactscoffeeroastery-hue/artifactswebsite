#!/usr/bin/env bash
# Anti-truncation pre-push guard (installed by install-anti-truncation-hook.sh).
# Blocks a push if any pushed text file has NUL-byte corruption or fails a
# syntax check. NUL tails come from edits that shrink a file without truncating.
#
# 2026-09-09 fixes (two bugs that made this block every push permanently):
#   1. It scanned EVERY tracked file whenever there was nothing new to push,
#      so one pre-existing file could block unrelated pushes forever. Now an
#      empty diff against upstream means "nothing to push" and passes.
#   2. It strict-JSON-parsed .json files, but VS Code configs (launch.json,
#      settings.json, tsconfig.json) are JSONC — comments and trailing commas
#      are legal there. Now retries with those stripped before failing.
set -u
cd "$(git rev-parse --show-toplevel)" 2>/dev/null || exit 0

# Work out what is actually being pushed.
if git rev-parse --abbrev-ref '@{u}' >/dev/null 2>&1; then
  # Upstream exists: check only what differs from it. Empty = nothing to push.
  FILES="$(git diff --name-only '@{u}...HEAD' 2>/dev/null)"
  if [ -z "$FILES" ]; then
    echo "Anti-truncation check: nothing new to push."
    exit 0
  fi
else
  # No upstream yet (first push of a branch) — check everything tracked.
  FILES="$(git ls-files)"
fi

SKIP='png|jpg|jpeg|gif|bmp|ico|webp|svgz|pdf|zip|gz|tgz|bz2|xz|rar|7z|xlsx|xls|docx|doc|pptx|ppt|woff|woff2|ttf|eot|otf|mp3|mp4|mov|avi|wav|flac|jar|class|so|dll|dylib|exe|bin|dat|db|sqlite|wasm'
fail=0
nul_count() { LC_ALL=C tr -d -c '\000' < "$1" | wc -c | tr -d '[:space:]'; }

# Strict JSON first; if that fails, retry allowing JSONC (comments + trailing
# commas). Only a file that fails BOTH is treated as broken, so genuine
# corruption is still caught while VS Code configs pass.
check_json() {
  node -e '
    const fs = require("fs");
    const raw = fs.readFileSync(process.argv[1], "utf8");
    try { JSON.parse(raw); process.exit(0); } catch (e) {}
    const stripped = raw
      .replace(/\/\*[\s\S]*?\*\//g, "")        // /* block comments */
      .replace(/(^|[^:"])\/\/.*$/gm, "$1")     // // line comments (not :// in URLs)
      .replace(/,(\s*[}\]])/g, "$1");          // trailing commas
    try { JSON.parse(stripped); process.exit(0); } catch (e) { process.exit(1); }
  ' "$1" 2>/dev/null
}

while IFS= read -r f; do
  [ -n "$f" ] && [ -f "$f" ] || continue
  ext="$(printf '%s' "${f##*.}" | tr 'A-Z' 'a-z')"
  printf '%s\n' "$ext" | grep -qiE "^($SKIP)$" && continue

  n="$(nul_count "$f")"
  if [ "${n:-0}" -ne 0 ] 2>/dev/null; then
    echo "  x NUL corruption: $f ($n null byte(s))"
    fail=1
    continue
  fi

  case "$ext" in
    js|jsx|mjs|cjs)
      command -v node >/dev/null 2>&1 && { node --check "$f" 2>/tmp/atg_err || { echo "  x JS syntax: $f"; sed 's/^/       /' /tmp/atg_err 2>/dev/null; fail=1; }; } ;;
    json|jsonc)
      command -v node >/dev/null 2>&1 && { check_json "$f" || { echo "  x JSON parse: $f"; fail=1; }; } ;;
    py)
      command -v python3 >/dev/null 2>&1 && { python3 -m py_compile "$f" 2>/dev/null || { echo "  x Python syntax: $f"; fail=1; }; } ;;
    sh|bash)
      bash -n "$f" 2>/dev/null || { echo "  x Shell syntax: $f"; fail=1; } ;;
  esac
done <<LIST
$FILES
LIST

if [ "$fail" -ne 0 ]; then
  echo ""
  echo "PUSH BLOCKED - file corruption or syntax errors above."
  echo "Fix a NUL tail:  tr -d '\\000' < FILE > FILE.tmp && mv -f FILE.tmp FILE"
  echo "Then commit the fix and push again."
  exit 1
fi
echo "Anti-truncation check passed."
exit 0
